<Project>
    <PropertyGroup>
        <!-- SPT specific  -->
        <!-- TODO: Change back to 4.1.0 before release-->
        <SptVersion Condition="'$(SptVersion)' == ''">4.0.13</SptVersion>
        <SptCommitTag Condition="'$(SptCommitTag)' == ''">abc123a</SptCommitTag>
        <Version>$(SptVersion)</Version>
        <AssemblyVersion>$(SptVersion)</AssemblyVersion>
        <FileVersion>$(SptVersion)</FileVersion>
        <InformationalVersion>$(SptVersion)</InformationalVersion>
        <!-- Project settings -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RepositoryType>Git</RepositoryType>
        <CETCompat>false</CETCompat>
    </PropertyGroup>
</Project>
