                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_average_life_span"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "AverageLifeSpan"))" P2="@(LocaleHelper.Get("profile_stats_survivals_row"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "SurvivalsInARow"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_online"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "Online"))" P2="@(LocaleHelper.Get("profile_stats_account_lifetime"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "AccountLifetime"))"/>
                </MudContainer>
            </MudContainer>
