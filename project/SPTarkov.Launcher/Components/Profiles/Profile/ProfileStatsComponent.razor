                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_average_life_span"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Scav, "AverageLifeSpan"))" P2="@(LocaleHelper.Get("profile_stats_survivals_row"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Scav, "SurvivalsInARow"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_online"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Scav, "Online"))" P2="@(LocaleHelper.Get("profile_stats_account_lifetime"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Scav, "AccountLifetime"))"/>
                </MudContainer>
            </MudContainer>
        </MudTabPanel>
    </MudTabs>
</MudItem>

@code {
    [Parameter]
    public MiniProfile MiniProfile { get; set; }

    private static string GetStat(IReadOnlyDictionary<string, string>? stats, string key)
    {
        return stats is not null && stats.TryGetValue(key, out var value) ? value : "—";
    }
}
