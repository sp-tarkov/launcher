@inject LocaleHelper LocaleHelper
@* TODO: Split to container component, get rid of the repeat *@

<MudItem sm="8">
    <MudTabs Centered="true" Color="Color.Dark" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" Class="mud-background-gray border-2 border-solid mud-border-lines-default card-container info-card-height">
        <MudTabPanel Text="@(LocaleHelper.Get("profile_stats_overall"))">
            <MudContainer>
                <MudContainer Class="d-flex flex-row justify-space-between">
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_raids"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "Raids"))" P2="@(LocaleHelper.Get("profile_stats_run_through"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "RunThrough"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_survived"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "Survived"))" P2="@(LocaleHelper.Get("profile_stats_awol"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "AWOL"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kia"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "KIA"))" P2="@(LocaleHelper.Get("profile_stats_mia"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "MIA"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kills"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "Kills"))" P2="@(LocaleHelper.Get("profile_stats_kd"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "KD"))"/>
                </MudContainer>
                <MudDivider DividerType="DividerType.Middle" Class="my-2"/>
                <MudContainer Class="d-flex flex-row justify-space-between">
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_survival_rate"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "SurvivalRate"))" P2="@(LocaleHelper.Get("profile_stats_leave_rate"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "LeaveRate"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_average_life_span"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "AverageLifeSpan"))" P2="@(LocaleHelper.Get("profile_stats_survivals_row"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "SurvivalsInARow"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_online"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Overall, "Online"))" P2="@(LocaleHelper.Get("profile_stats_account_lifetime"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Overall, "AccountLifetime"))"/>
                </MudContainer>
            </MudContainer>
        </MudTabPanel>
