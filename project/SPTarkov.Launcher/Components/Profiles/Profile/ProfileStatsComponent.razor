                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_survived"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Scav, "Survived"))" P2="@(LocaleHelper.Get("profile_stats_awol"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Scav, "AWOL"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kia"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Scav, "KIA"))" P2="@(LocaleHelper.Get("profile_stats_mia"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Scav, "MIA"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kills"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Scav, "Kills"))" P2="@(LocaleHelper.Get("profile_stats_kd"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Scav, "KD"))"/>
                </MudContainer>
                <MudDivider DividerType="DividerType.Middle" Class="my-2"/>
                <MudContainer Class="d-flex flex-row justify-space-between">
