                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kia"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "KIA"))" P2="@(LocaleHelper.Get("profile_stats_mia"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "MIA"))"/>
                    <ProfileStatsSubColComponent P1="@(LocaleHelper.Get("profile_stats_kills"))" P1Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "Kills"))" P2="@(LocaleHelper.Get("profile_stats_kd"))" P2Value="@(GetStat(MiniProfile.ProfileStats.Pmc, "KD"))"/>
