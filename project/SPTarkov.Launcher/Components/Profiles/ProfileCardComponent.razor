@inject IDialogService DialogService
@inject ConfigHelper ConfigHelper
@inject StateHelper StateHelper
@inject NavigationManager NavigationManager
@inject ILogger<ProfileCardComponent> Logger
@inject LocaleHelper LocaleHelper
@inject WindowsClipboard WindowsClipboard
@inject ISnackbar Snackbar

<MudItem sm="4">
    <MudPaper Elevation="2" Class="@CardClassNames()" @onclick="RunLoginTask">
        <div class="card-overflow no-select no-pointers">
            @if (!SideIsUnknown && !HideSideImage)
            {
                <MudImage Src=@(ImageName()) Elevation="0" Class=@(ImageClassNames())/>
            }
        </div>

        <div class="d-flex align-center justify-space-between no-select">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Style="@ProfileIconStyle" Class="no-pointers"/>
                <div class="d-flex align-center gap-1 card-actions" @onclick:stopPropagation="true">
                    <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" ShowOnHover="true"
                                ShowOnFocus="false" ShowOnClick="false" Text="@(LocaleHelper.Get("profile_copy_id"))">
                        <MudIconButton Disabled="!IsWindows" Icon="@Icons.Material.Filled.FileCopy" Color="Color.Inherit" Size="Size.Small"
                                       OnClick="CopyProfileId"/>
                    </MudTooltip>
                    @if (!HideDeleteButton)
                    {
                        <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" ShowOnHover="true"
                                    ShowOnFocus="false" ShowOnClick="false" Text="@(LocaleHelper.Get("profile_card_delete"))">
                            <MudIconButton Class="card-action-delete" Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit"
                                           Size="Size.Small" OnClick="RunDeleteTask"/>
                        </MudTooltip>
                    }
                </div>
            </div>
            <div class="d-flex align-center gap-3">
                @if (MiniProfile.InvalidOrUnloadableProfile)
                {
                    <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top"
                                Text="@(LocaleHelper.Get("profile_card_invalid"))">
                        <div class="card-status card-status--offline">
                            <span class="card-status-dot"></span>
                            <span class="card-status-label">@(LocaleHelper.Get("profile_card_status_invalid"))</span>
                        </div>
                    </MudTooltip>
                }
                <span class="card-meta no-pointers">@(LocaleHelper.Get("profile_card_level")) @MiniProfile.CurrentLevel</span>
            </div>
        </div>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("profile_card_name")):</MudText>
        <MudText Typo="Typo.h6" Class="text-overflow no-pointers no-select">@MiniProfile.Username</MudText>

        <MudDivider DividerType="DividerType.FullWidth"/>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("profile_card_edition")):</MudText>
        <MudText Typo="Typo.h6" Class="text-overflow no-pointers no-select">@MiniProfile.Edition</MudText>

        <MudDivider DividerType="DividerType.FullWidth"/>

        <MudText Class="mb-n3 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("profile_card_id")):</MudText>
        <MudText Typo="Typo.body1" Class="text-overflow card-mono">@MiniProfile.ProfileId</MudText>
    </MudPaper>
</MudItem>

@code {
    [Parameter] public bool HideDeleteButton { get; set; }

    [Parameter] public bool HideSideImage { get; set; }

    [Parameter] public MiniProfile MiniProfile { get; set; } = default!;

    [Parameter] public List<MiniProfile> ProfileList { get; set; } = [];

    [Parameter] public EventCallback<List<MiniProfile>> ProfileListChanged { get; set; }

    private bool IsWindows => OperatingSystem.IsWindows();

    private bool CardIsClickable => !HideDeleteButton && !MiniProfile.InvalidOrUnloadableProfile;

    // Deterministic per-profile tint for the header glyph, hashed from the username.
    private string ProfileIconStyle => $"color: {ModPageVisual.GetColor(MiniProfile.Username)};";

    private bool SideIsUnknown { get; set; }

    private string GetSideAsString()
    {
        return string.IsNullOrEmpty(MiniProfile.Side.ToLower()) ? "unknown" : MiniProfile.Side.ToLower();
    }

    private string CardClassNames()
    {
        return new CssBuilder()
            .AddClass("pa-4 d-flex flex-column flex-none gap-2 border-2 border-solid mud-border-lines-default card-container info-card-height")
            .AddClass("cursor-pointer card-interactive", CardIsClickable)
            .Build();
    }

    private string ImageClassNames()
    {
        var side = GetSideAsString();

        return new CssBuilder()
            .AddClass("no-pointers")
            .AddClass("no-select")
            .AddClass($"background-image-{side}")
            .Build();
    }

    private string ImageName()
    {
        var side = GetSideAsString();

        if (side == "unknown")
        {
            return "";
        }

        return $"/images/side_{side}.png";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (MiniProfile.Side.ToLower() == "unknown")
        {
            SideIsUnknown = true;
        }
    }

    private async Task RunLoginTask()
    {
        if (!CardIsClickable)
        {
            return;
        }

        var dialogParams = new DialogParameters
        {
            {
                "MiniProfile", MiniProfile
            }
        };

        var dialog = await DialogService.ShowAsync<ProfileLoginDialog>("ProfileLoginDialog", dialogParams, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            StateHelper.SetSelectedProfile(MiniProfile);

            Logger.LogDebug("Navigating to /ServerPageWrapper/false");
            NavigationManager.NavigateTo("/ServerPageWrapper/false");
        }
    }

    private async Task RunDeleteTask()
    {
        var dialogParams = new DialogParameters
        {
            {
                "MiniProfile", MiniProfile
            }
        };

        var dialog = await DialogService.ShowAsync<ProfileRemoveDialog>("ProfileRemoveDialog", dialogParams, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ProfileList = StateHelper.ProfileList;
            await ProfileListChanged.InvokeAsync(ProfileList);
        }
    }

    private void CopyProfileId()
    {
        if (!IsWindows)
        {
            return;
        }

        if (WindowsClipboard.CopyText(MiniProfile.ProfileId))
        {
            Logger.LogDebug("Copied profile id to clipboard: {id}", MiniProfile.ProfileId);
            Snackbar.Add(LocaleHelper.Get("profile_copy_id_success"), Severity.Success);
        }
        else
        {
            Snackbar.Add(LocaleHelper.Get("profile_copy_id_error"), Severity.Error);
        }
    }

}
