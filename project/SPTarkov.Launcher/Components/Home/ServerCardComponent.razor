@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject StateHelper StateHelper
@inject ConfigHelper ConfigHelper
@inject LocaleHelper LocaleHelper
@inject HttpHelper HttpHelper
@implements IDisposable

<MudItem md="4">
    <MudPaper Elevation="2" Class="@CardClassNames()" @onclick="RunLoginTask">

        <div class="d-flex align-center justify-space-between no-select">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Inherit" Style="@ServerIconStyle" Class="no-pointers"/>
                @if (Server.Locked)
                {
                    <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" Text="@(LocaleHelper.Get("server_card_protect"))">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="server-card-lock"/>
                    </MudTooltip>
                }
                else
                {
                    <div class="d-flex align-center gap-1 server-card-actions" @onclick:stopPropagation="true">
                        <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" Text="@(LocaleHelper.Get("server_card_edit"))">
                            <MudIconButton Icon="@Icons.Material.Filled.Build" Color="Color.Inherit" Size="Size.Small" OnClick="RunEditTask"/>
                        </MudTooltip>
                        <MudTooltip Color="Color.Dark" Arrow="false" Inline="false" Placement="Placement.Top" Text="@(LocaleHelper.Get("server_card_delete"))">
                            <MudIconButton Class="server-card-action-delete" Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" Size="Size.Small" OnClick="RunDeleteTask"/>
                        </MudTooltip>
                    </div>
                }
            </div>
            <div class="server-status @StatusModifier() no-pointers">
                <span class="server-status-dot"></span>
                <span class="server-status-label">@StatusLabel()</span>
            </div>
        </div>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("server_card_name"))</MudText>
        <MudText Typo="Typo.h6" Class="no-pointers no-select">@Server.Name</MudText>

        <MudDivider DividerType="DividerType.FullWidth"/>

        <MudText Class="mb-n4 no-pointers no-select" Typo="Typo.caption">@(LocaleHelper.Get("server_card_address"))</MudText>
        <MudText Typo="Typo.h6" Class="server-address no-pointers no-select">@Server.IpAddress</MudText>

    </MudPaper>
</MudItem>

@code {
    [Parameter] public Server Server { get; set; } = default!;

    [Parameter] public List<Server> ServerList { get; set; } = [];

    [Parameter] public EventCallback<List<Server>> ServerListChanged { get; set; }

    private enum ServerStatus
    {
        Checking,
        Online,
        Offline,
    }

    private static readonly TimeSpan _statusProbeTimeout = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan _statusPollInterval = TimeSpan.FromSeconds(15);

    private ServerStatus _status = ServerStatus.Checking;

    // Cancelled on dispose to stop the status poll and any in-flight probe.
    private readonly CancellationTokenSource _disposeCts = new();

    // This card represents the server the launcher is currently connected to.
    private bool IsConnected => StateHelper.SelectedServer?.ServerId == Server.ServerId;

    // Deterministic per-server tint for the header glyph, hashed from name and address.
    private string ServerIconStyle => $"color: {ModPageVisual.GetColor($"{Server.Name}|{Server.IpAddress}")};";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = PollStatusAsync(_disposeCts.Token);
    }

    // Probe now and every _statusPollInterval thereafter until the component is disposed.
    private async Task PollStatusAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(_statusPollInterval);

        try
        {
            do
            {
                await RefreshStatusAsync(token);
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException)
        {
            // Disposed... stop polling.
        }
    }

    private async Task RefreshStatusAsync(CancellationToken token)
    {
        if (IsConnected)
        {
            return; // Connection already tracked
        }

        using var probeCts = CancellationTokenSource.CreateLinkedTokenSource(token);
        probeCts.CancelAfter(_statusProbeTimeout);

        var online = await HttpHelper.PingServerAsync(Server.IpAddress, probeCts.Token);
        _status = online ? ServerStatus.Online : ServerStatus.Offline;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component is gone; nothing to update. Shame.
        }
    }

    private string StatusLabel()
    {
        if (IsConnected)
        {
            return LocaleHelper.Get("server_card_connected");
        }

        return _status switch
        {
            ServerStatus.Online => LocaleHelper.Get("server_card_status_online"),
            ServerStatus.Offline => LocaleHelper.Get("server_card_status_offline"),
            _ => LocaleHelper.Get("server_card_status_checking"),
        };
    }

    private string StatusModifier()
    {
        if (IsConnected)
        {
            return "server-status--connected";
        }

        return _status switch
        {
            ServerStatus.Online => "server-status--online",
            ServerStatus.Offline => "server-status--offline",
            _ => "server-status--checking",
        };
    }

    private string CardClassNames()
    {
        return new CssBuilder()
            .AddClass("pa-4 d-flex flex-column flex-none gap-2 border-2 border-solid mud-border-lines-default card-container cursor-pointer server-card")
            .AddClass("server-card-connected", IsConnected)
            .Build();
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private async Task RunEditTask()
    {
        if (StateHelper.SelectedServer?.ServerId == Server.ServerId)
        {
            StateHelper.LogoutAndDispose();
        }

        var param = new DialogParameters
        {
            {
                "Server", Server
            }
        };

        var dialog = await DialogService.ShowAsync<ServerEditDialog>("ServerEditDialog", param, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            var serverToChange = ServerList.FirstOrDefault(x => x.ServerId == Server.ServerId);

            if (serverToChange != null)
            {
                serverToChange.Name = Server.Name;
                serverToChange.IpAddress = Server.IpAddress;
            }

            ConfigHelper.SetServers(ServerList);
            await ServerListChanged.InvokeAsync(ServerList);
        }
    }

    private async Task RunLoginTask()
    {
        if (StateHelper.SelectedServer != null)
        {
            if (StateHelper.SelectedServer.ServerId == Server.ServerId)
            {
                StateHelper.LogoutAndDispose();
                return;
            }

            StateHelper.LogoutAndDispose();
        }

        var param = new DialogParameters
        {
            {
                "Server", Server
            }
        };

        var dialog = await DialogService.ShowAsync<ServerLoginDialog>("ServerLoginDialog", param, ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            StateHelper.SetSelectedServer(Server);
            StateHelper.SetAllowServerPage(true);

            NavigationManager.NavigateTo("/Profiles");
        }
    }

    private async Task RunDeleteTask()
    {
        if (StateHelper.SelectedServer != null)
        {
            StateHelper.LogoutAndDispose();
        }

        var dialog = await DialogService.ShowAsync<ServerRemoveDialog>("ServerRemoveDialog", ConfigHelper.DialogOptions);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            ServerList.Remove(Server);
            await ServerListChanged.InvokeAsync(ServerList);

            ConfigHelper.SetServers(ServerList);
        }
    }

}
