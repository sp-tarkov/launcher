@inject LocaleHelper LocaleHelper

<MudContainer Class="d-flex flex-column px-0 mb-4">
    <MudGrid Class="search-component">
        <MudItem sm="12">
            <MudTextField @bind-Value="SearchValue" Label="@(LocaleHelper.Get("search_title"))" Variant="Variant.Outlined" Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"  Clearable="true"
                          DebounceInterval="500" OnDebounceIntervalElapsed="SearchFunc" />
        </MudItem>
        <MudItem Class="pt-3" sm="3">
            <MudSelect @bind-Value="SortValue" Label="@(LocaleHelper.Get("search_sort"))" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.Sort" >
                <MudSelectItem Value="@("-downloads")">@(LocaleHelper.Get("search_most_download"))</MudSelectItem>
                <MudSelectItem Value="@("-updated_at")">@(LocaleHelper.Get("search_recently_updated"))</MudSelectItem>
                <MudSelectItem Value="@("-created_at")">@(LocaleHelper.Get("search_newest"))</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem Class="pt-3" sm="3">
            <MudSelect @bind-Value="FilterValue" Label="@(LocaleHelper.Get("featured"))" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.FilterAlt" >
                <MudSelectItem Value="@("Include")">@(LocaleHelper.Get("search_include"))</MudSelectItem>
                <MudSelectItem Value="@("Exclude")">@(LocaleHelper.Get("search_exclude"))</MudSelectItem>
                <MudSelectItem Value="@("Only")">@(LocaleHelper.Get("search_only"))</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem Class="pt-3" sm="3">
            <MudSelect @bind-Value="CategoryValue" Label="@(LocaleHelper.Get("search_category"))" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.FilterAlt" >
                <MudSelectItem Value="@("all-cat")">All Categories</MudSelectItem>

                @if (Categories is not null)
                {
                    @foreach (var cat in Categories)
                    {
                        <MudSelectItem Value="@cat.Slug">@cat.Title</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem Class="pt-3" sm="3">
            <MudSelect @bind-Value="AiValue" Label="@(LocaleHelper.Get("search_ai_content"))" Variant="Variant.Outlined" Dense="true" AdornmentIcon="@Icons.Material.Filled.FilterAlt" >
                <MudSelectItem Value="@("Exclude")">@(LocaleHelper.Get("search_exclude"))</MudSelectItem>
                <MudSelectItem Value="@("Include")">@(LocaleHelper.Get("search_include"))</MudSelectItem>
                <MudSelectItem Value="@("Only")">@(LocaleHelper.Get("search_only"))</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
#pragma warning disable BL0007
    [Parameter]
    public string SearchValue
    {
        get;
        set
        {
            if (field == value)
            {
                return;
            }

            field = value;
            SearchValueChanged.InvokeAsync(field);
        }
    } = "";

    [Parameter]
    public EventCallback<string> SearchValueChanged { get; set; }

    [Parameter]
    public string SortValue
    {
        get;
        set
        {
            if (field == value)
            {
                return;
            }

            field = value;
            SortValueChanged.InvokeAsync(field);
        }
    } = "-downloads";

    [Parameter]
    public EventCallback<string> SortValueChanged { get; set; }

    [Parameter]
    public string FilterValue
    {
        get;
        set
        {
            if (field == value)
            {
                return;
            }

            field = value;
            FilterValueChanged.InvokeAsync(field);
        }
    } = "Include";

    [Parameter]
    public EventCallback<string> FilterValueChanged { get; set; }

    [Parameter]
    public string AiValue
    {
        get;
        set
        {
            if (field == value)
            {
                return;
            }

            field = value;
            AiValueChanged.InvokeAsync(field);
        }
    } = "Exclude";

    [Parameter]
    public EventCallback<string> AiValueChanged { get; set; }

    [Parameter]
    public string CategoryValue
    {
        get;
        set
        {
            if (field == value)
            {
                return;
            }

            field = value;
            CategoryValueChanged.InvokeAsync(field);
        }
    } = "all-cat";

    [Parameter]
    public EventCallback<string> CategoryValueChanged { get; set; }

    [Parameter]
    public Func<Task> SearchFunc { get; set; } = () => Task.CompletedTask;

    [Parameter]
    public List<ForgeCategory>? Categories { get; set; }
}
