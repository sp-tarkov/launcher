@inject IJSRuntime JsRuntime
@inject LocaleHelper LocaleHelper
@inject IDialogService DialogService
@inject ConfigHelper ConfigHelper
@inject ILogger<DetailedModComponent> Logger
@inject NavigationManager NavigationManager
@inject ModManager ModManager

<MudItem sm="12">
    @if (IsSkeleton)
    {
        // Create replica of Below layout as a skeleton
        <MudGrid>
            <MudItem sm="8">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px"/>
            </MudItem>
            <MudItem sm="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Class="mb-4"/>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px"/>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid>
            <MudItem sm="12" Class="d-flex flex-row align-center">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" IconColor="Color.Error" Color="Color.Dark" Size="Size.Medium" Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" OnClick="NavigateBack">
                    @(LocaleHelper.Get("mod_navigate_back"))
                </MudButton>
                <MudSpacer/>
                <MudTooltip Arrow="false" Placement="Placement.Bottom" Color="Color.Default" ShowOnHover="true" ShowOnClick="false" ShowOnFocus="false" RootClass="mr-3" Text="@StatusTooltip">
                    <MudIcon Icon="@StatusIcon" Color="@StatusColor" Class="d-block"/>
                </MudTooltip>
                <MudButton Color="Color.Dark" StartIcon="@Icons.Material.Filled.Download" IconColor="@StatusColor" Variant="Variant.Filled" Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Disabled="@(!CanDownload)" OnClick="StartDownloadModTask">
                    @DownloadLatestLabel
                </MudButton>
            </MudItem>
            <MudItem sm="8" Class="pt-4">
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4">
                    <MudCardHeader>
                        <MudGrid>
                            <MudItem sm="3">
                                <MudImage Src=@(ForgeMod.GetThumbnail()) Class="mod-thumbnail" Style="background-color: transparent !important;"/>
                            </MudItem>
                            <MudItem sm="9">
                                <MudItem Class="d-flex mud-width-full">
                                    <MudTooltip Arrow="false" Placement="Placement.Bottom" Color="Color.Default" ShowOnHover="true" ShowOnClick="false" ShowOnFocus="false" Text="@(LocaleHelper.Get("mod_open_forge"))">
                                        <MudLink Color="Color.Default" Underline="Underline.Always" Href="@($"https://forge.sp-tarkov.com/mod/{ForgeMod.Id}/{ForgeMod.Slug}/")" Typo="Typo.h6">@ForgeMod.Name</MudLink>
                                    </MudTooltip>
                                </MudItem>
                                <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_by")) @ForgeMod.GetModdersName()</MudText>
                                <MudText Typo="Typo.body2" Class="no-pointers no-select">@ForgeMod.Downloads @(LocaleHelper.Get("mod_download"))</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>@ForgeMod.Teaser</MudText>
                    </MudCardContent>
                </MudCard>
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default">
                    <MudCardContent Class="user-markdown">@((MarkupString)(ForgeMod.Description ?? string.Empty))</MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem sm="4" Class="pt-4">
                @if (ForgeMod.CheatNotice)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-error mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_warning_title"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_cheat_notice_text"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true"><MudLink Typo="Typo.caption" Underline="Underline.Always" Href="https://forge.sp-tarkov.com/content-guidelines#anti-cheat-policy"> @(LocaleHelper.Get("mod_cheat_notice_link"))</MudLink></MudText>
                        </MudCardContent>
                    </MudCard>
                }
                @if (!IsVersionCompatible)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-error mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_notice_title"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_spt_incompatible_notice"))</MudText>
                        </MudCardContent>
                    </MudCard>
                }
                @if (_blockedDependencyItems is not null)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-warning mb-4">
                        <MudCardContent Class="d-flex flex-column">
                            <MudText Typo="Typo.caption" Class="pb-2">@(LocaleHelper.Get("download_deps_blocked_title"))</MudText>
                            <ul class="blocked-deps-list">
                                @foreach (var item in _blockedDependencyItems)
                                {
                                    <li>
                                        <MudText Typo="Typo.caption" Class="d-block">@item.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@item.Detail</MudText>
                                    </li>
                                }
                            </ul>
                        </MudCardContent>
                    </MudCard>
                }
                @if (_dependencyCheckFailed)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-warning mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_notice_title"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("download_deps_resolve_failed"))</MudText>
                        </MudCardContent>
                    </MudCard>
                }
                @if (ForgeMod.ShowsProfileBindingNotice)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-warning mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_notice_title"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true">@(LocaleHelper.Get("mod_notice_text"))</MudText>
                            <MudText Typo="Typo.caption" Inline="true"><MudLink Typo="Typo.caption" Underline="Underline.Always" Href="https://wiki.sp-tarkov.com/Profiles#mods"> @(LocaleHelper.Get("mod_notice_link"))</MudLink></MudText>
                        </MudCardContent>
                    </MudCard>
                }
                @if (HasAiDisclosure)
                {
                    <MudCard Class="border-2 border-solid mud-alert-outlined-warning mb-4">
                        <MudCardContent>
                            <MudText Typo="Typo.caption">@(LocaleHelper.Get("mod_ai_disclosure_title"))</MudText>
                            @if (HasCustomAiDisclosure)
                            {
                                <div class="user-markdown">@((MarkupString)ForgeMod.CustomAiDisclosure!)</div>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">@(LocaleHelper.Get("mod_ai_disclosure_text"))</MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                }
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default">
                    <MudCardContent Class="d-flex flex-column align-start">
                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_guid"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">@ForgeMod.GUID</MudText>


                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_additional_authors"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">@(ForgeMod.GetAdditionalAuthors() ?? LocaleHelper.Get("mod_none"))</MudText>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_license"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                            @if (ForgeMod.License is not null)
                            {
                                <MudLink Typo="Typo.caption" Color="Color.Default" Underline="Underline.Always" Href="@ForgeMod.License.Link">@ForgeMod.License.Name</MudLink>
                            }
                            else
                            {
                                @(LocaleHelper.Get("mod_none"))
                            }
                        </MudText>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_category"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">@(ForgeMod.Category?.Title ?? LocaleHelper.Get("mod_none"))</MudText>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_source_code"))</MudText>
                        @if (ForgeMod.SourceCodeLinks?.Any() ?? false)
                        {
                            @foreach (var link in ForgeMod.SourceCodeLinks)
                            {
                                <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                                    <MudLink Color="Color.Default" Underline="Underline.Always" Typo="Typo.caption" Href="@link.Url">@(string.IsNullOrEmpty(link.Label) ? link.Url : link.Label)</MudLink>
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                                @(LocaleHelper.Get("mod_none"))
                            </MudText>
                        }

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_virustotal"))</MudText>
                        @if (ForgeModVersion.VirusTotalLinks?.Any() ?? false)
                        {
                            @foreach (var link in ForgeModVersion.VirusTotalLinks)
                            {
                                <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                                    <MudLink Color="Color.Default" Underline="Underline.Always" Typo="Typo.caption" Href="@link.Url">@(string.IsNullOrEmpty(link.Label) ? link.Url : link.Label)</MudLink>
                                </MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                                @(LocaleHelper.Get("mod_none"))
                            </MudText>
                        }

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_spt_version"))</MudText>
                        <MudTooltip Arrow="false" Placement="Placement.Bottom" Color="Color.Default" ShowOnHover="true" ShowOnClick="false" ShowOnFocus="false" Text="@CompatibilityTooltip">
                            <MudText Typo="Typo.caption" Color="@CompatibilityColor" Class="pb-2 text-overflow">@(ForgeModVersion?.SptVersionConstraint?.ToString() ?? LocaleHelper.Get("mod_none"))</MudText>
                        </MudTooltip>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_file_size"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">@(ForgeModVersion?.GetContentLengthFormatted() ?? LocaleHelper.Get("mod_none"))</MudText>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_fika_Compatible"))</MudText>
                        <MudText Typo="Typo.caption" Class="pb-2 text-overflow">@(ForgeMod.FikaCompatible ?? false ? LocaleHelper.Get("mod_yes") : LocaleHelper.Get("mod_no"))</MudText>

                        <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_dependencies"))</MudText>
                        @if (ForgeModVersion.Dependencies?.Any() ?? false)
                        {
                            @foreach (var dep in ForgeModVersion.Dependencies)
                            {
                                <MudTooltip ShowOnHover="true" Placement="Placement.Left" Arrow="false" ShowOnClick="false" ShowOnFocus="false" Text="@dep.Name">
                                    <MudLink Color="Color.Default" Underline="Underline.None" Href="@($"ForgeMod/{dep.Id}")" Class="d-flex align-center cursor-pointer setting-on-hover pa-2 mud-width-full overflow-hidden">
                                        <MudImage Class="flex-shrink-0" Width="50" Height="50" Src="@dep.GetThumbnail()"/>
                                        <MudContainer Class="flex-1 gap-3 px-2">
                                            <MudText Class="no-select text-overflow" Typo="Typo.h6">@dep.Name</MudText>
                                            <MudText Class="no-select text-overflow" Typo="Typo.caption">@($"{LocaleHelper.Get("mod_requires")} {dep.Versions?.First().Version} - {dep.Owner?.Name}")</MudText>
                                        </MudContainer>
                                    </MudLink>
                                </MudTooltip>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="pb-2 text-overflow">
                                @(LocaleHelper.Get("mod_none"))
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
                @if (IsVersionCompatible && HasCompatibleAddons)
                {
                    <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default mt-4">
                        <MudCardContent Class="d-flex flex-column align-start">
                            <MudText Typo="Typo.body1" Class="no-pointers no-select">@(LocaleHelper.Get("mod_addons"))</MudText>
                            @foreach (var addon in ForgeModAddons)
                            {
                                @if (GetCompatibleAddonVersion(addon) is not { } addonVersion)
                                {
                                    continue;
                                }

                                <MudTooltip ShowOnHover="true" Placement="Placement.Left" Arrow="false" ShowOnClick="false" ShowOnFocus="false" Text="@addon.Name">
                                    <MudLink Color="Color.Default" Underline="Underline.None" Class="d-flex align-center cursor-pointer setting-on-hover pa-2 mud-width-full overflow-hidden" OnClick="() => StartDownloadAddonTask(addon.Id)">
                                        <MudImage Class="flex-shrink-0" Width="50" Height="50" Src="@addon.GetThumbnail()"/>
                                        <MudContainer Class="flex-1 gap-3 px-2 overflow-hidden">
                                            <MudText Class="no-select text-overflow" Typo="Typo.h6">@addon.Name</MudText>
                                            <MudText Class="no-select text-overflow" Typo="Typo.caption">@($"{LocaleHelper.Get("mod_requires")} {addonVersion.Version} - {addon.Owner?.Name}")</MudText>
                                        </MudContainer>
                                    </MudLink>
                                </MudTooltip>
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </MudItem>
        </MudGrid>
    }
</MudItem>

@code {
    [Parameter] public bool IsSkeleton { get; set; }
    [Parameter] public ForgeBase ForgeMod { get; set; } = default!;
    [Parameter] public ForgeModVersion ForgeModVersion { get; set; } = default!;
    [Parameter] public List<ForgeBase> ForgeModAddons { get; set; } = [];

    private DependencyResolution? _dependencyResolution;
    private List<BlockedDependency>? _blockedDependencyItems;
    private bool _dependencyCheckFailed;
    private int? _checkedVersionId;

    private bool IsVersionCompatible => ForgeModVersion?.SptVersionConstraint?.IsSatisfied(ProgramStatics.SptVersionCompiledFor, true) ?? false;

    private bool DependencyCheckPending => _dependencyResolution is null && !_dependencyCheckFailed;

    private bool CanDownload => IsVersionCompatible && _dependencyResolution is not null && _blockedDependencyItems is null;

    private Color CompatibilityColor => IsVersionCompatible ? Color.Success : Color.Error;

    private string CompatibilityTooltip => LocaleHelper.Get(IsVersionCompatible ? "mod_spt_compatible" : "mod_spt_incompatible");

    private string StatusIcon =>
        !IsVersionCompatible ? Icons.Material.Filled.Error
        : _dependencyCheckFailed || _blockedDependencyItems is not null ? Icons.Material.Filled.Warning
        : DependencyCheckPending ? Icons.Material.Filled.HourglassTop
        : Icons.Material.Filled.CheckCircle;

    private Color StatusColor =>
        !IsVersionCompatible ? Color.Error
        : _dependencyCheckFailed || _blockedDependencyItems is not null ? Color.Warning
        : DependencyCheckPending ? Color.Default
        : Color.Success;

    private string StatusTooltip =>
        !IsVersionCompatible ? LocaleHelper.Get("mod_spt_incompatible")
        : _dependencyCheckFailed ? LocaleHelper.Get("download_deps_resolve_failed")
        : _blockedDependencyItems is not null ? LocaleHelper.Get("mod_deps_blocked")
        : DependencyCheckPending ? LocaleHelper.Get("mod_deps_checking")
        : LocaleHelper.Get("mod_spt_compatible");

    private string DownloadLatestLabel =>
        ForgeModVersion is null
            ? LocaleHelper.Get("mod_download_latest")
            : $"{LocaleHelper.Get("mod_download_latest")} ({ForgeModVersion.Version})";

    private bool HasCompatibleAddons => ForgeModAddons?.Any(addon => GetCompatibleAddonVersion(addon) is not null) ?? false;

    private bool HasAiDisclosure => ForgeMod?.ContainsAiContent == true || HasCustomAiDisclosure;

    private bool HasCustomAiDisclosure => !string.IsNullOrWhiteSpace(ForgeMod?.CustomAiDisclosure);

    private ForgeModVersion? GetCompatibleAddonVersion(ForgeBase addon)
    {
        if (ForgeModVersion is null)
        {
            return null;
        }

        return addon.Versions?.FirstOrDefault(v => v.ModVersionConstraint?.IsSatisfied(ForgeModVersion.Version, true) ?? false);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            JsRuntime.InvokeVoidAsync("setTabContent");
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsSkeleton || ForgeModVersion is null || _checkedVersionId == ForgeModVersion.Id)
        {
            return;
        }

        _checkedVersionId = ForgeModVersion.Id;
        _dependencyResolution = null;
        _blockedDependencyItems = null;
        _dependencyCheckFailed = false;

        if (ForgeModVersion.Dependencies is not { Count: > 0 })
        {
            _dependencyResolution = new DependencyResolution();
            return;
        }

        var resolution = await ModManager.ResolveDependencies(ForgeMod.GUID ?? ForgeMod.Id.ToString(), ForgeModVersion.Version);

        if (resolution is null)
        {
            _dependencyCheckFailed = true;
            return;
        }

        _dependencyResolution = resolution;
        if (resolution.IsBlocked)
        {
            _blockedDependencyItems = DependencyDisplay.BuildBlockedItems(resolution, LocaleHelper);
        }
    }

    private async Task StartDownloadModTask()
    {
        var param = new DialogParameters
        {
            {
                "Mod", ForgeMod
            },
            {
                "Version", ForgeModVersion
            },
            {
                "Resolution", _dependencyResolution
            }
        };

        var options = new DialogOptions
        {
            Position = ConfigHelper.DialogOptions.Position,
            MaxWidth = MaxWidth.Large,
            BackdropClick = ConfigHelper.DialogOptions.BackdropClick,
            CloseOnEscapeKey = ConfigHelper.DialogOptions.CloseOnEscapeKey,
            NoHeader = ConfigHelper.DialogOptions.NoHeader,
            CloseButton = ConfigHelper.DialogOptions.CloseButton,
            FullScreen = ConfigHelper.DialogOptions.FullScreen,
            FullWidth = ConfigHelper.DialogOptions.FullWidth,
            BackgroundClass = ConfigHelper.DialogOptions.BackgroundClass,
        };

        var dialog = await DialogService.ShowAsync<ForgeDownloadDialog>("ForgeDownloadDialog", param, options);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            Logger.LogInformation("Started Download for {mod}", ForgeMod.Name);
            return;
        }

        Logger.LogInformation("Download cancelled for {mod}", ForgeMod.Name);
    }

    private async Task StartDownloadAddonTask(int id)
    {
        var param = new DialogParameters
        {
            {
                "ModAddon", ForgeModAddons.FirstOrDefault(x => x.Id == id)
            }
        };

        var options = new DialogOptions
        {
            Position = ConfigHelper.DialogOptions.Position,
            MaxWidth = MaxWidth.Large,
            BackdropClick = ConfigHelper.DialogOptions.BackdropClick,
            CloseOnEscapeKey = ConfigHelper.DialogOptions.CloseOnEscapeKey,
            NoHeader = ConfigHelper.DialogOptions.NoHeader,
            CloseButton = ConfigHelper.DialogOptions.CloseButton,
            FullScreen = ConfigHelper.DialogOptions.FullScreen,
            FullWidth = ConfigHelper.DialogOptions.FullWidth,
            BackgroundClass = ConfigHelper.DialogOptions.BackgroundClass,
        };

        var dialog = await DialogService.ShowAsync<ForgeAddonDialog>("ForgeAddonDialog", param, options);
        var result = await dialog.Result;

        if (result?.Canceled is false)
        {
            Logger.LogInformation("Started Download for {mod}", ForgeMod.Name);
            return;
        }

        Logger.LogInformation("Download cancelled for {mod}", ForgeMod.Name);
    }

    private void NavigateBack()
    {
        // this doesn't seem to work on linux, so navigating back to forge instead of last page
        if (OperatingSystem.IsWindows())
        {
            JsRuntime.InvokeVoidAsync("navigateBack");
        }
        else
        {
            NavigationManager.NavigateTo("/Forge");
        }
    }

}
