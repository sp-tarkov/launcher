@* A left-rail icon link with a text tooltip. Hovering it dismisses the mod-pages panel. *@

@inject StateHelper StateHelper

<div @onpointerenter="CloseModPagesPanel">
    <MudTooltip Color="Color.Dark" Arrow="false" Placement="Placement.Right" ShowOnHover="true" ShowOnClick="false" Inline="false" Text="@Text" @bind-Visible="_visible">
        <MudNavLink Disabled="Disabled" IconColor="Color.Default" Icon="@Icon" Match="NavLinkMatch.All" Href="@Href" OnClick="Close"/>
    </MudTooltip>
</div>

@code {
    private bool _visible;

    [Parameter]
    [EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Icon { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Href { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    private void Close()
    {
        _visible = false;
    }

    private void CloseModPagesPanel()
    {
        StateHelper.SetModPagesPanelOpen(false);
    }
}
