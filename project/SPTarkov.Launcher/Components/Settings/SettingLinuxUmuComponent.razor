@inject ConfigHelper ConfigHelper

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
        <MudTextField @bind-Value="NewValue" Label="Umu Path" Variant="Variant.Outlined" Immediate="true"
                      Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Folder"
                      AdornmentColor="Color.Info" OnAdornmentClick="SetUmuPath"/>
        <MudIconButton Color="@(NewValue == OldValue ? Color.Default : Color.Success)" Icon="@Icons.Material.Filled.Save"
                       Disabled="@(NewValue == OldValue)" OnClick="Save"/>
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AddDiv { get; set; }

    private string OldValue { get; set; } = "";
    private string NewValue { get; set; } = "";

    protected override void OnInitialized()
    {
        OldValue = ConfigHelper.GetConfig().LinuxSettings.UmuPath;
        NewValue = OldValue;

        base.OnInitialized();
    }

    private string GetLinkClasses()
    {
        var classes = new CssBuilder()
            .AddClass("d-flex")
            .AddClass("justify-center")
            .AddClass("align-center")
            .AddClass("py-2")
            .AddClass("pl-5");

        if (!Disabled)
        {
            classes.AddClass("cursor-pointer").AddClass("setting-on-hover");
        }

        return classes.Build();
    }

    private async Task SetUmuPath()
    {
        // umu-run is a file, a folder dialog cant select it
        var file = await Launcher.App.MainWindow.ShowOpenFileAsync(title: "Choose umu-run", defaultPath: FilePickerHelper.StartDirectory(NewValue));

        // no file was selected
        if (!file.Any())
        {
            return;
        }

        NewValue = file.FirstOrDefault()!;
        Save();
    }

    private void Save()
    {
        OldValue = NewValue;
        ConfigHelper.SetLinuxUmuPath(NewValue);
        StateHasChanged();
    }
}
