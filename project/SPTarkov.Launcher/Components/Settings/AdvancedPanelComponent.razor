@inject ConfigHelper ConfigHelper
@inject StateHelper StateHelper
@inject LocaleHelper LocaleHelper

<MudItem sm="12">
    <MudPaper Class="pa-5 gap-2 d-flex flex-column setting-on-hover-container mud-background-gray border-2 border-solid mud-border-lines-default" Elevation="3">
        <MudTooltip Color="Color.Dark" Arrow="false" Placement="Placement.Bottom" Text="Image cannot be changed for now">
            <SettingSwitchComponent Switch="@ShowBackgroundSwitch" OptionName="@(LocaleHelper.Get("setting_option_background"))" SwitchFunc="SetBackgroundUsage"/>
        </MudTooltip>
        <SettingLocaleComponent Options="@LocaleOptions" OptionName="@(LocaleHelper.Get("setting_option_language"))"/>
        <SettingChannelComponent/>
        <SettingSwitchComponent Switch="@CheckForUpdatesOnStartupSwitch" SwitchFunc="SetCheckForUpdatesOnStartup" OptionName="@(LocaleHelper.Get("setting_option_update_on_startup"))"/>
        <SettingSwitchComponent Switch="@ClearCacheOnLaunchSwitch" SwitchFunc="SetClearCacheOnLaunch" OptionName="@(LocaleHelper.Get("setting_option_clear_cache"))"></SettingSwitchComponent>
        <SettingGamePath />
    </MudPaper>
</MudItem>

@code
{
    private bool ShowBackgroundSwitch { get; set; }
    private bool ClearCacheOnLaunchSwitch { get; set; }
    private bool CheckForUpdatesOnStartupSwitch { get; set; }
    private Dictionary<string, string> LocaleOptions { get; set; } = [];

    protected override void OnInitialized()
    {
        var config = ConfigHelper.GetConfig();
        ShowBackgroundSwitch = config.UseBackground;
        ClearCacheOnLaunchSwitch = config.ClearCacheOnLaunch;
        CheckForUpdatesOnStartupSwitch = config.CheckForUpdatesOnStartup;

        LocaleOptions = LocaleHelper.GetAvailableLocales();
        base.OnInitialized();
    }

    private Task SetClearCacheOnLaunch()
    {
        ClearCacheOnLaunchSwitch = !ClearCacheOnLaunchSwitch;
        ConfigHelper.SetClearCacheOnLaunch(ClearCacheOnLaunchSwitch);

        return Task.CompletedTask;
    }

    private Task SetCheckForUpdatesOnStartup()
    {
        CheckForUpdatesOnStartupSwitch = !CheckForUpdatesOnStartupSwitch;
        ConfigHelper.SetCheckForUpdatesOnStartup(CheckForUpdatesOnStartupSwitch);

        return Task.CompletedTask;
    }

    private Task SetBackgroundUsage()
    {
        ShowBackgroundSwitch = !ShowBackgroundSwitch;
        ConfigHelper.SetUseBackground(ShowBackgroundSwitch);
        StateHelper.SetBackground();

        return Task.CompletedTask;
    }
}
