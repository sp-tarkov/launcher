@page "/Forge"

@inject HttpHelper HttpHelper
@inject StateHelper StateHelper
@inject ILogger<Forge> Logger
@inject LocaleHelper LocaleHelper
@inject ForgeRateLimiter RateLimiter
@inject NavigationManager NavigationManager
@implements IDisposable

<MudContainer Class="px-4 mt-2 mb-6" MaxWidth="MaxWidth.Large">
    @if (NetAvailable != false)
    {
        @if (NetAvailable is null || GettingCategories)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Width="100%" />
        }
        else
        {
            <MudItem sm="12" Class="mb-6">
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default px-4 pt-4 pb-2">
                    <SearchComponent @ref="SearchComponentRef" @bind-SearchValue="SearchValue" @bind-FilterValue="FilterValue" @bind-SortValue="SortValue" @bind-AiValue="AiValue" @bind-CategoryValue="CategoryValue" Categories="@Categories"/>

                    @if (SearchResponse?.Meta?.LastPage is not null && SearchResponse?.Data?.Count > 0)
                    {
                        <MudItem sm="12" Class="d-flex justify-center">
                            <MudPagination Rectangular="true" Variant="Variant.Text" Count="@((int)SearchResponse.Meta.LastPage)" Class="mb-4"
                                           ShowFirstButton="true" ShowLastButton="true" ShowNextButton="true" ShowPreviousButton="true" @bind-Selected="@PaginationValue" Disabled="@SearchInProgress"/>
                        </MudItem>
                    }
                </MudCard>
            </MudItem>
        }
    }

    @if (RateLimited)
    {
        <MudItem sm="12">
            <MudPaper Elevation="2" Class="pa-4 border-2 border-solid mud-border-lines-default card-container">
                <MudContainer Class="d-flex flex-column align-center gap-2 py-12">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Style="font-size: 4rem;" Class="mud-text-secondary"/>
                    <MudText Typo="Typo.h6" Align="Align.Center">@(LocaleHelper.Get("forge_rate_limited_title"))</MudText>
                    <MudText Align="Align.Center" Class="mud-text-secondary">@RateLimitedSubtitle</MudText>
                </MudContainer>
            </MudPaper>
        </MudItem>
    }

    else if (NetAvailable == false)
    {
        <MudItem sm="12">
            <MudPaper Elevation="2" Class="pa-4 border-2 border-solid mud-border-lines-default card-container">
                <MudContainer Class="d-flex flex-column align-center gap-2 py-12">
                    <MudIcon Icon="@Icons.Material.Filled.WifiOff" Style="font-size: 4rem;" Class="mud-text-secondary"/>
                    <MudText Typo="Typo.h6" Align="Align.Center">@(LocaleHelper.Get("forge_offline_title"))</MudText>
                    <MudText Align="Align.Center" Class="mud-text-secondary">@(LocaleHelper.Get("forge_offline_subtitle"))</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckInternetAccess" Class="mt-2">@(LocaleHelper.Get("forge_offline_refresh"))</MudButton>
                </MudContainer>
            </MudPaper>
        </MudItem>
    }

    else if (SearchFailed)
    {
        <MudItem sm="12">
            <MudPaper Elevation="2" Class="pa-4 border-2 border-solid mud-border-lines-default card-container">
                <MudContainer Class="d-flex flex-column align-center gap-2 py-12">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="font-size: 4rem;" Class="mud-text-secondary"/>
                    <MudText Typo="Typo.h6" Align="Align.Center">@(LocaleHelper.Get("forge_error_title"))</MudText>
                    <MudText Align="Align.Center" Class="mud-text-secondary">@(LocaleHelper.Get("forge_search_failed"))</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckInternetAccess" Class="mt-2">@(LocaleHelper.Get("forge_error_retry"))</MudButton>
                </MudContainer>
            </MudPaper>
        </MudItem>
    }

    else if (SearchResponse is null || SearchInProgress)
    {
        <MudGrid>
            <ModCardComponent IsSkeleton="true"/>
            <ModCardComponent IsSkeleton="true"/>
        </MudGrid>
    }
    else if (SearchResponse?.Data?.Count > 0)
    {
        <MudGrid>
            @foreach (var mod in SearchResponse.Data)
            {
                <ModCardComponent ForgeMod="@mod"/>
            }
        </MudGrid>
    }
    else
    {
        <MudItem sm="12">
            <MudPaper Elevation="2" Class="pa-4 border-2 border-solid mud-border-lines-default card-container">
                <MudContainer Class="d-flex flex-column align-center gap-2 py-12">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 4rem;" Class="mud-text-secondary"/>
                    <MudText Typo="Typo.h6" Align="Align.Center">@NoResultsTitle</MudText>
                    <MudText Align="Align.Center" Class="mud-text-secondary">@(LocaleHelper.Get("forge_no_results_subtitle"))</MudText>
                    @if (StateHelper.HasNonDefaultForgeFilters)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFilters" Class="mt-2">@(LocaleHelper.Get("forge_no_results_clear"))</MudButton>
                    }
                </MudContainer>
            </MudPaper>
        </MudItem>
    }

</MudContainer>

@code {
    private bool? NetAvailable { get; set; }
    private ForgeModsResponse? SearchResponse { get; set; }
    private bool SearchInProgress { get; set; }
    private bool SearchFailed { get; set; }
    private bool RateLimited { get; set; }
    private System.Threading.Timer? RateLimitTicker { get; set; }
    private CancellationTokenSource? SearchCts { get; set; }
    private List<ForgeCategory>? Categories => StateHelper.ListOfCategoriesAvailable;
    private bool GettingCategories { get; set; }
    private SearchComponent? SearchComponentRef { get; set; }
    private string NoResultsTitle => string.Format(LocaleHelper.Get("forge_no_results_title"), ProgramStatics.SptVersionCompiledFor);
    private string RateLimitedSubtitle => string.Format(LocaleHelper.Get("forge_rate_limited_subtitle"), (int)Math.Ceiling(RateLimiter.TimeRemaining?.TotalSeconds ?? 0));

    private int PaginationValue
    {
        get => StateHelper.CurrentPagination;
        set
        {
            if (StateHelper.CurrentPagination == value)
            {
                return;
            }

            StateHelper.CurrentPagination = value;
            _ = SearchForMods(value);
        }
    }

    public string SearchValue
    {
        get => StateHelper.CurrentSearch;
        set
        {
            if (StateHelper.CurrentSearch == value)
            {
                return;
            }

            StateHelper.CurrentSearch = value;
            _ = SearchUpdate();
        }
    }

    public string SortValue
    {
        get => StateHelper.CurrentSort;
        set
        {
            if (StateHelper.CurrentSort == value)
            {
                return;
            }

            StateHelper.CurrentSort = value;
            _ = SearchUpdate();
        }
    }

    public string FilterValue
    {
        get => StateHelper.CurrentFilter;
        set
        {
            if (StateHelper.CurrentFilter == value)
            {
                return;
            }

            StateHelper.CurrentFilter = value;
            _ = SearchUpdate();
        }
    }

    public string AiValue
    {
        get => StateHelper.CurrentAi;
        set
        {
            if (StateHelper.CurrentAi == value)
            {
                return;
            }

            StateHelper.CurrentAi = value;
            _ = SearchUpdate();
        }
    }

    public string CategoryValue
    {
        get => StateHelper.CurrentCategory;
        set
        {
            if (StateHelper.CurrentCategory == value)
            {
                return;
            }

            StateHelper.CurrentCategory = value;
            _ = SearchUpdate();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!StateHelper.IsLocalServerSelected)
        {
            NavigationManager.NavigateTo("/ServerPageWrapper/false");
            return;
        }

        await base.OnInitializedAsync();
        RateLimiter.RateLimitChanged += OnRateLimitChanged;
        await CheckInternetAccess();
    }

    private void OnRateLimitChanged()
    {
        if (RateLimiter.TimeRemaining is { } remaining)
        {
            RateLimited = true;
            ExtendSearchTimeout(remaining);
            StartRateLimitTicker();
            InvokeAsync(StateHasChanged);
            return;
        }

        if (RateLimited)
        {
            ExitRateLimitedState();
        }
    }

    // Reschedules the active search timeout to outlast the rate limit wait.
    private void ExtendSearchTimeout(TimeSpan remaining)
    {
        try
        {
            SearchCts?.CancelAfter(remaining + TimeSpan.FromSeconds(10));
        }
        catch (ObjectDisposedException)
        {
            // Newer search disposed this cts.
        }
    }

    private void StartRateLimitTicker()
    {
        RateLimitTicker ??= new System.Threading.Timer(_ => OnRateLimitTick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopRateLimitTicker()
    {
        RateLimitTicker?.Dispose();
        RateLimitTicker = null;
    }

    private void OnRateLimitTick()
    {
        if (RateLimiter.TimeRemaining is null)
        {
            ExitRateLimitedState();
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private void ExitRateLimitedState()
    {
        RateLimited = false;
        StopRateLimitTicker();

        if (SearchInProgress)
        {
            InvokeAsync(StateHasChanged);
            return;
        }

        InvokeAsync(CheckInternetAccess);
    }

    private async Task CheckInternetAccess()
    {
        if (RateLimiter.TimeRemaining is not null)
        {
            RateLimited = true;
            StartRateLimitTicker();
            return;
        }

        NetAvailable = null;
        SearchFailed = false;

        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
        NetAvailable = await HttpHelper.ForgePing(cts.Token);

        if (NetAvailable == false)
        {
            return;
        }

        if (StateHelper.ListOfCategoriesAvailable is null || !StateHelper.ListOfCategoriesAvailable.Any())
        {
            await GetCategories();
        }

        await SearchForMods();
    }

    private async Task SearchUpdate()
    {
        await SearchForMods(1);
    }

    private async Task ClearFilters()
    {
        StateHelper.ResetForgeFilters();

        if (SearchComponentRef is not null)
        {
            await SearchComponentRef.ClearSearchText();
        }

        await SearchUpdate();
    }

    private async Task GetCategories()
    {
        GettingCategories = true;

        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var response = await HttpHelper.ForgeGetCategories(token.Token);
            StateHelper.ListOfCategoriesAvailable = response?.Data;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.ForgeGetCategories {Exception}", e);
        }
        finally
        {
            GettingCategories = false;
            StateHasChanged();
        }
    }

    private async Task SearchForMods(int? page = null)
    {
        SearchCts?.Cancel();
        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
        SearchCts = cts;

        SearchInProgress = true;
        SearchFailed = false;
        page ??= StateHelper.CurrentPagination;

        try
        {
            var response = await HttpHelper.ForgeGetMods(cts.Token, SearchValue, SortValue, (int)page, FilterValue, AiValue, CategoryValue);

            if (SearchCts != cts)
            {
                return;
            }

            if (response is null || !response.Success)
            {
                Logger.LogError("Forge mod search failed. Search: {Search}, SortValue: {SortValue}, page: {page}, FilterValue: {FilterValue}, AiValue: {AiValue}", SearchValue, SortValue, page, FilterValue, AiValue);

                SearchResponse = null;
                SearchFailed = true;
            }
            else
            {
                SearchResponse = response;
            }

            StateHelper.CurrentPagination = (int)page;
        }
        catch (OperationCanceledException) when (SearchCts != cts)
        {
            // superseded by a newer search; the newer request renders its own results
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.SearchForMods {Exception}", e);

            if (SearchCts == cts)
            {
                SearchResponse = null;
                SearchFailed = true;
            }
        }
        finally
        {
            if (SearchCts == cts)
            {
                SearchCts = null;
                SearchInProgress = false;
                StateHasChanged();
            }

            cts.Dispose();
        }
    }

    public void Dispose()
    {
        RateLimiter.RateLimitChanged -= OnRateLimitChanged;
        StopRateLimitTicker();
    }
}
