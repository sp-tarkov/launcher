@page "/Forge"

@inject HttpHelper HttpHelper
@inject StateHelper StateHelper
@inject ILogger<Forge> Logger

<MudContainer Class="px-4 mt-2 mb-6" MaxWidth="MaxWidth.Large">
    @* TODO: remember to remove this *@
    <div class="mud-overlay dialog-backdrop-class">
        <div class="mud-overlay-scrim mud-overlay-dark">
            <MudContainer Class="d-flex flex-column justify-center align-center absolute mud-height-full">
                <MudText Color="Color.Info" Typo="Typo.h3">Coming Soon!</MudText>
            </MudContainer>
        </div>
    </div>
    @if (NetAvailable)
    {
        @if (GettingCategories)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Width="100%" />
        }
        else
        {
            <MudItem sm="12" Class="mb-6">
                <MudCard Class="mud-background-gray border-2 border-solid mud-border-lines-default px-4 pt-4 pb-2">
                    <SearchComponent @bind-SearchValue="SearchValue" @bind-FilterValue="FilterValue" @bind-SortValue="SortValue" @bind-AiValue="AiValue" @bind-CategoryValue="CategoryValue" Categories="@Categories?.Data" SearchFunc="@SearchUpdate"/>

                    @if (SearchResponse?.Meta?.LastPage is not null && SearchResponse?.Data?.Count > 0)
                    {
                        <MudItem sm="12" Class="d-flex justify-center">
                            <MudPagination Rectangular="true" Variant="Variant.Text" Count="@((int)SearchResponse.Meta.LastPage)" Class="mb-4"
                                           ShowFirstButton="true" ShowLastButton="true" ShowNextButton="true" ShowPreviousButton="true" @bind-Selected="@PaginationValue" Disabled="@SearchInProgress"/>
                        </MudItem>
                    }
                </MudCard>
            </MudItem>
        }
    }

    @if (!NetAvailable)
    {
        <MudItem sm="12">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No Internet access found, please fix and refresh!</MudAlert>
        </MudItem>
        <MudItem sm="12" Class="mt-4 d-flex justify-center align-center">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckInternetAccess">Refresh</MudButton>
        </MudItem>
    }

    else if (SearchResponse is null || SearchInProgress)
    {
        <MudGrid>
            <ModCardComponent IsSkeleton="true"/>
            <ModCardComponent IsSkeleton="true"/>
        </MudGrid>
    }
    else if (SearchResponse?.Data?.Count > 0)
    {
        <MudGrid>
            @foreach (var mod in SearchResponse.Data)
            {
                <ModCardComponent ForgeMod="@mod"/>
            }
        </MudGrid>
    }
    else if (SearchResponse?.Data?.Count == 0)
    {
        // decide if i actually wanna put something here
    }

</MudContainer>

@code {
    private bool NetAvailable { get; set; }
    private ForgeModsResponse? SearchResponse { get; set; }
    private bool SearchInProgress { get; set; }
    private ForgeCategoriesResponse? Categories { get; set; }
    private bool GettingCategories { get; set; }

    private int PaginationValue
    {
        get => StateHelper.CurrentPagination;
        set
        {
            if (StateHelper.CurrentPagination == value)
            {
                return;
            }

            StateHelper.CurrentPagination = value;
            _ = SearchForMods(value);
        }
    }

    public string SearchValue
    {
        get => StateHelper.CurrentSearch;
        set
        {
            if (StateHelper.CurrentSearch == value)
            {
                return;
            }

            StateHelper.CurrentSearch = value;
            _ = SearchUpdate();
        }
    }

    public string SortValue
    {
        get => StateHelper.CurrentSort;
        set
        {
            if (StateHelper.CurrentSort == value)
            {
                return;
            }

            StateHelper.CurrentSort = value;
            _ = SearchUpdate();
        }
    }

    public string FilterValue
    {
        get => StateHelper.CurrentFilter;
        set
        {
            if (StateHelper.CurrentFilter == value)
            {
                return;
            }

            StateHelper.CurrentFilter = value;
            _ = SearchUpdate();
        }
    }

    public string AiValue
    {
        get => StateHelper.CurrentAi;
        set
        {
            if (StateHelper.CurrentAi == value)
            {
                return;
            }

            StateHelper.CurrentAi = value;
            _ = SearchUpdate();
        }
    }

    public string CategoryValue
    {
        get => StateHelper.CurrentCategory;
        set
        {
            if (StateHelper.CurrentCategory == value)
            {
                return;
            }

            StateHelper.CurrentCategory = value;
            _ = SearchUpdate();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        NetAvailable = HttpHelper.IsInternetAccessAvailable();

        if (!NetAvailable)
        {
            return;
        }

        if (StateHelper.ListOfCategoriesAvailable is null || !StateHelper.ListOfCategoriesAvailable.Any())
        {
            await GetCategories();
        }

        await SearchForMods();
    }

    private void CheckInternetAccess()
    {
        NetAvailable = HttpHelper.IsInternetAccessAvailable();
    }

    private async Task SearchUpdate()
    {
        await SearchForMods(1);
    }

    private async Task GetCategories()
    {
        GettingCategories = true;

        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            Categories = await HttpHelper.ForgeGetCategories(token.Token);
        }
        catch (ForgeRetryException e)
        {
            Logger.LogError(e.Message);
            GettingCategories = false;
            return;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.ForgeGetCategories {Exception}", e);
            return;
        }

        GettingCategories = false;
        StateHasChanged();
    }

    private async Task SearchForMods(int? page = null)
    {
        if (SearchInProgress)
        {
            // do this to stop multiple requests happening at the same time
            return;
        }

        SearchInProgress = true;
        page ??= StateHelper.CurrentPagination;

        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            SearchResponse = await HttpHelper.ForgeGetMods(token.Token, SearchValue, SortValue, (int)page, FilterValue, AiValue, CategoryValue);
        }
        catch (ForgeRetryException e)
        {
            Logger.LogError(e.Message);
            SearchInProgress = false;
            return;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.SearchForMods {Exception}", e);
            return;
        }

        if (!SearchResponse!.Success)
        {
            Logger.LogError("Something failed");
            Logger.LogError("Request info: Search: {Search}, SortValue: {SortValue}, page: {page}, FilterValue: {FilterValue}, AiValue: {AiValue}", SearchValue, SortValue, page, FilterValue, AiValue);
            Logger.LogError("Response: {SearchResponse}", SearchResponse);

            SearchResponse = null;
        }

        PaginationValue = (int) page;
        StateHelper.CurrentPagination = PaginationValue;
        SearchInProgress = false;
        StateHasChanged();
    }
}
