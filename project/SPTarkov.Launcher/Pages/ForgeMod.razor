@page "/ForgeMod/{ModId}"

@inject HttpHelper HttpHelper
@inject ILogger<ForgeMod> Logger
@inject TitleHelper TitleHelper

<MudContainer Class="px-4 mt-2 mb-6" MaxWidth="MaxWidth.Large">
    <MudGrid>
        @if (SearchResponse is null || SearchInProgress || VersionResponse is null)
        {
            <DetailedModComponent IsSkeleton="true"/>
        }
        else if (SearchResponse.Data is not null && VersionResponse.Data?.FirstOrDefault() is { } version)
        {
            <DetailedModComponent ForgeMod="@SearchResponse.Data" ForgeModVersion="@version" ForgeModAddons="@(AddonResponse?.Data ?? [])"/>
        }
    </MudGrid>
</MudContainer>

@code {
    private ForgeModResponse? SearchResponse { get; set; }
    private ForgeVersionResponse? VersionResponse { get; set; }
    private ForgeAddonResponse? AddonResponse { get; set; }
    private bool SearchInProgress { get; set; }

    [Parameter]
    public string ModId { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        await SearchForMod();

        var firstVersion = SearchResponse?.Data?.Versions?.FirstOrDefault();
        if (firstVersion != null)
        {
            await SearchForModVersion(ModId, firstVersion.Id.ToString());
        }

        await SearchForModAddons(ModId);
        await base.OnInitializedAsync();
    }

    private async Task SearchForMod()
    {
        SearchInProgress = true;

        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var response = await HttpHelper.ForgeGetMod(ModId, token.Token);

            if (response is null)
            {
                Logger.LogError("Getting mod {modId} returned no response", ModId);
                return;
            }

            SearchResponse = response;

            if (SearchResponse.Data is not null)
            {
                TitleHelper.Apply($"ForgeMod/{ModId}", SearchResponse.Data.Name);
            }
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.SearchForMod {Exception}", e);
            return;
        }

        SearchInProgress = false;
        StateHasChanged();
    }

    private async Task SearchForModVersion(string modId, string versionId)
    {
        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var response = await HttpHelper.ForgeGetModVersion(modId, versionId, token.Token);

            if (response is null)
            {
                Logger.LogError("Getting mod version {modId}:{versionId} returned no response", modId, versionId);
                return;
            }

            VersionResponse = response;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.SearchForModVersion {Exception}", e);
            return;
        }

        if (!VersionResponse.Success)
        {
            Logger.LogError("Getting Mod version failed {modId}:{versionId} for reason: {code}:{message}", modId, versionId, VersionResponse.Code, VersionResponse.Message);
        }

        StateHasChanged();
    }

    private async Task SearchForModAddons(string modId)
    {
        try
        {
            var token = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var response = await HttpHelper.ForgeGetModAddons(modId, token.Token);

            if (response is null)
            {
                Logger.LogError("Getting mod addons {modId} returned no response", modId);
                return;
            }

            AddonResponse = response;
        }
        catch (Exception e)
        {
            Logger.LogError("Exception thrown from ForgeHelper.SearchForModAddons {Exception}", e);
            return;
        }

        if (!AddonResponse.Success)
        {
            Logger.LogError("Getting Mod Addons failed {modId}", modId);
        }

        StateHasChanged();
    }
}
