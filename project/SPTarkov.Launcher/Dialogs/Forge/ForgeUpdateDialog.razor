@inject ISnackbar Snackbar
@inject ModManager ModManager
@inject ILogger<ForgeDownloadDialog> Logger
@inject HttpHelper HttpHelper
@inject LocaleHelper LocaleHelper

<MudDialog Class="mud-background-gray border-2 border-solid mud-border-lines-default">
    <DialogContent>
        @if (!CheckedForUpdates)
        {
            <MudContainer Class="d-flex flex-column gap-1 mt-4">
                <MudPaper Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4 pa-2">
                    <MudText>@_taskText</MudText>
                </MudPaper>
                <MudContainer Class="mb-4 pa-0">
                    <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.Download" IconColor="Color.Success" OnClick="CheckForUpdates" Disabled="@_requestInProgress">@(LocaleHelper.Get("forge_update_check"))</MudButton>
                    <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" OnClick="UserCancelled">@(LocaleHelper.Get("forge_update_close"))</MudButton>
                </MudContainer>
            </MudContainer>
        }
        else if (CheckedForUpdates && ForgeUpdateResponse is not null && ForgeUpdateResponse.Success && ForgeUpdateResponse.Data is not null && ForgeUpdateResponse.Data.Updates.Any())
        {
            <MudContainer Class="d-flex flex-column gap-1 mt-4">
                <MudPaper Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4 pa-2">
                    <MudText>@_taskText</MudText>
                    <MudDivider DividerType="DividerType.Middle" />
                    @foreach (var item in ForgeUpdateResponse.Data.Updates)
                    {
                        <MudText Class="py-2">@item.CurrentVersion.Name</MudText>
                    }
                </MudPaper>
                <MudContainer Class="mb-4 pa-0">
                    <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.Download" IconColor="Color.Success" OnClick="RunUpdates" Disabled="@_requestInProgress">@(LocaleHelper.Get("forge_update_check"))</MudButton>
                    <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" OnClick="UserCancelled">@(LocaleHelper.Get("forge_update_cancel"))</MudButton>
                </MudContainer>
            </MudContainer>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private bool _requestInProgress;
    private CancellationTokenSource Token { get; set; } = new();
    private bool UserCancel { get; set; }
    private string _taskText = "";
    private bool CheckedForUpdates { get; set; }
    private ForgeUpdateResponse? ForgeUpdateResponse { get; set; }
    private bool NoModsToUpdate { get; set; }

    protected override Task OnInitializedAsync()
    {
        _taskText = LocaleHelper.Get("forge_update_check");

        return base.OnInitializedAsync();
    }

    private async Task<ForgeUpdateResponse?> CallForge(string taskText = "", string failString = "")
    {
        _taskText = taskText;
        StateHasChanged();
        await Task.Delay(20);

        var listOfModsToCheck = ModManager.GetMods().Where(w => !w.Value.IsInstalled).Select(x => $"{x.Key}:{x.Value.ModVersion}").ToList();

        if (!listOfModsToCheck.Any())
        {
            Logger.LogDebug("Forge ForgeGetUpdate No mods found to check");
            NoModsToUpdate = true;
            return null;
        }

        var response = await HttpHelper.ForgeGetUpdate(listOfModsToCheck, ProgramStatics.SptVersionCompiledFor.ToString(), Token.Token);

        if (response is null)
        {
            Logger.LogWarning("Forge ForgeGetUpdate response is null");
        }

        if (response!.Success)
        {
            Logger.LogInformation("Forge ForgeGetUpdate Authenticated");
        }

        if (!response.Success)
        {
            Logger.LogWarning("Forge ForgeGetUpdate NOT - Authenticated");
            Token.Dispose();
            AbortOrFail(failString);
        }

        return response;
    }

    private async Task CheckForUpdates()
    {
        _requestInProgress = true;
        Token = new CancellationTokenSource(); // Dont give a timeout, some people might just have shit internet
        try
        {
            ForgeUpdateResponse = await CallForge(LocaleHelper.Get("forge_update_checking"), LocaleHelper.Get("forge_update_failed"));
            // we abort if failed so no need to check result
            CheckedForUpdates = true;

            if ((ForgeUpdateResponse is not null && ForgeUpdateResponse.Data?.Updates.Any() != true) || (NoModsToUpdate && ForgeUpdateResponse == null))
            {
                Snackbar.Add(LocaleHelper.Get("forge_update_none"), Severity.Info);
                Submit();
                return;
            }

            _taskText = LocaleHelper.Get("forge_update_detected");
        }
        catch (TaskCanceledException) when (Token.IsCancellationRequested)
        {
            AbortOrFail(LocaleHelper.Get("request_timed_out"));
            return;
        }
        catch (HttpRequestException)
        {
            AbortOrFail();
            return;
        }
        catch (Exception)
        {
            AbortOrFail();
            return;
        }

        _requestInProgress = false;
    }

    private async Task RunUpdates()
    {
        _taskText = LocaleHelper.Get("forge_update_updating");
        StateHasChanged();

        if (ForgeUpdateResponse?.Data == null)
        {
            return;
        }

        foreach (var forgeModUpdate in ForgeUpdateResponse.Data.Updates)
        {
            await ModManager.UpdateMod(forgeModUpdate, Token.Token);
        }

        _taskText = LocaleHelper.Get("forge_update_updated");
        StateHasChanged();
        await Task.Delay(1000);

        Submit();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void AbortOrFail(string? message = null)
    {
        message ??= LocaleHelper.Get("forge_update_aborted");

        if (!UserCancel)
        {
            Snackbar.Add(message, Severity.Error);
        }

        Token.Cancel();
        MudDialog.Cancel();
        _requestInProgress = false;
    }

    private void UserCancelled()
    {
        UserCancel = true;
        _requestInProgress = false;
        Token.Cancel();
        MudDialog.Cancel();
    }

}
