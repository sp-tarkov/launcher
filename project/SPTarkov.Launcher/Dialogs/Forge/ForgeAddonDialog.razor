@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject ModManager ModManager
@inject HttpHelper HttpHelper
@inject LocaleHelper LocaleHelper

<MudDialog Class="mud-background-gray border-2 border-solid mud-border-lines-default">
    <DialogContent>
        <MudContainer Class="d-flex flex-column gap-1 mt-4">
            <MudPaper Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4 pa-2">
                <MudText>@(LocaleHelper.Get("addons_read_me"))</MudText>
            </MudPaper>

            @if (AddonDetails is null || _requestInProgress)
            {
                <MudSkeleton Animation="Animation.Pulse" Height="300px" SkeletonType="SkeletonType.Rectangle" Width="900"></MudSkeleton>
            }
            else
            {
                <MudPaper Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4 pa-2">
                    <MudText Class="user-markdown">
                        @((MarkupString)(AddonDetails.Description ?? string.Empty))
                    </MudText>
                </MudPaper>
                @if (AddonDependencies != null && AddonDependencies.Any())
                {
                    <MudPaper Class="mud-background-gray border-2 border-solid mud-border-lines-default mb-4 pa-2 d-flex flex-column">
                        <MudText Class="pb-2">@(LocaleHelper.Get("addons_deps_text"))</MudText>
                        <MudDivider DividerType="DividerType.Middle" Class="pb-2" />
                            @foreach (var dep in AddonDependencies)
                            {
                                <MudText Typo="Typo.caption" >@($"{dep.Name} - {dep.Versions?.FirstOrDefault()?.Version}.")</MudText>
                            }
                    </MudPaper>
                }
            }
            @if (_blockedItems is not null)
            {
                <MudPaper Class="mud-background-gray border-2 border-solid mud-alert-outlined-warning mb-4 pa-2 d-flex flex-column">
                    <MudText Class="pb-2">@(LocaleHelper.Get("download_deps_blocked_title"))</MudText>
                    <MudDivider DividerType="DividerType.Middle" Class="pb-2" />
                    <ul class="blocked-deps-list">
                        @foreach (var item in _blockedItems)
                        {
                            <li>
                                <MudText Typo="Typo.caption" Class="d-block">@item.Name</MudText>
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@item.Detail</MudText>
                            </li>
                        }
                    </ul>
                </MudPaper>
            }
            <MudContainer Class="mb-4 pa-0">
                <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" StartIcon="@Icons.Material.Filled.Download" IconColor="Color.Success" OnClick="RunDownloadTask" Disabled="@(_requestInProgress || _blockedItems is not null)">@(LocaleHelper.Get("mod_download"))</MudButton>
                <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Dark" OnClick="UserCancelled">@(LocaleHelper.Get("forge_update_close"))</MudButton>
            </MudContainer>
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ForgeBase ModAddon { get; set; } = default!;
    private ForgeBase? AddonDetails { get; set; }
    private List<ForgeBase>? AddonDependencies => ModAddon.Versions?.FirstOrDefault()?.Dependencies;

    private bool _requestInProgress;
    private CancellationTokenSource Token { get; set; } = new();
    private bool UserCancel { get; set; }
    private List<BlockedDependency>? _blockedItems;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = GetModAddonDetails();
            JsRuntime.InvokeVoidAsync("setTabContent");
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task GetModAddonDetails()
    {
        _requestInProgress = true;

        try
        {
            Token = new CancellationTokenSource();
            var addonDetails = await HttpHelper.ForgeGetModAddonDetails(ModAddon.Id.ToString(), Token.Token);
            AddonDetails = addonDetails?.Data;
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }

        _requestInProgress = false;
        StateHasChanged();
    }

    private async Task RunDownloadTask()
    {
        _requestInProgress = true;
        _blockedItems = null;
        Token = new CancellationTokenSource(); // Dont give a timeout, some people might just have shit internet

        var version = AddonDetails?.Versions?.FirstOrDefault();
        if (AddonDetails is null || version is null)
        {
            AbortOrFail();
            return;
        }

        try
        {
            var resolution = await ModManager.ResolveDependencies(
                AddonDetails.GUID ?? AddonDetails.Id.ToString(),
                version.Version,
                Token.Token
            );

            if (resolution is null)
            {
                AbortOrFail(LocaleHelper.Get("download_deps_resolve_failed"));
                return;
            }

            if (resolution.IsBlocked)
            {
                _blockedItems = DependencyDisplay.BuildBlockedItems(resolution, LocaleHelper);
                _requestInProgress = false;
                return;
            }

            _ = ModManager.DownloadModWithDependencies(AddonDetails, version, resolution, Token.Token);
        }
        catch (Exception)
        {
            AbortOrFail();
            return;
        }

        _requestInProgress = false;
        Submit();
    }

    private void Submit()
    {
        Snackbar.Add($"Download started for {ModAddon.Name}", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void AbortOrFail(string message = "Cancelled download")
    {
        if (!UserCancel)
        {
            Snackbar.Add(message, Severity.Error);
        }

        Token.Cancel();
        MudDialog.Cancel();
        _requestInProgress = false;
    }

    private void UserCancelled()
    {
        UserCancel = true;
        _requestInProgress = false;
        Token.Cancel();
        MudDialog.Cancel();
    }
}
