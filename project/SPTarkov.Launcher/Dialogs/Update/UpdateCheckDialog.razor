@inject ILogger<UpdateCheckDialog> Logger
@inject LocaleHelper LocaleHelper
@inject ConfigHelper ConfigHelper
@inject UpdateInstaller UpdateInstaller
@inject BrowserBridge BrowserBridge
@inject ISnackbar Snackbar

<MudDialog Class="update-dialog mud-background-gray border-2 border-solid mud-border-lines-default">
    <DialogContent>
        @if (_restartRequired)
        {
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-center gap-3">
                    <div class="update-header-icon update-header-icon--warning">
                        <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Warning"/>
                    </div>
                    <MudText Typo="Typo.h6">@(LocaleHelper.Get("update_check_title"))</MudText>
                </div>

                <MudText>@(LocaleHelper.Get("update_install_relaunch_failed"))</MudText>

                <div class="mt-2 d-flex justify-end gap-2">
                    <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Default" OnClick="Close">@(LocaleHelper.Get("update_check_close"))</MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-center gap-3">
                    <div class="update-header-icon">
                        <MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Success"/>
                    </div>
                    <MudText Typo="Typo.h6" Class="flex-grow-1">@(LocaleHelper.Get("update_check_available_heading"))</MudText>
                    @ChannelBadge
                </div>

                <div class="update-versions rounded border-2 border-solid mud-border-lines-default">
                    <div class="update-version">
                        <span class="update-version-number">@Update.CurrentVersion.ToString()</span>
                        <span class="update-version-label">@(LocaleHelper.Get("update_version_current"))</span>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Class="update-version-arrow"/>
                    <div class="update-version update-version--new">
                        <span class="update-version-number">@Update.Release.LauncherVersion</span>
                        <span class="update-version-label">@(LocaleHelper.Get("update_version_new"))</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Update.Release.Notes))
                {
                    <div class="user-markdown update-notes rounded border-2 border-solid mud-border-lines-default">@MarkdownRenderer.ToHtml(Update.Release.Notes)</div>
                }

                @if (!string.IsNullOrWhiteSpace(Update.Release.NotesUrl))
                {
                    <MudLink Class="update-notes-link cursor-pointer" @onclick="OpenNotes">@(LocaleHelper.Get("update_check_view_notes"))<MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="update-notes-link-icon"/></MudLink>
                }

                @if (_installing)
                {
                    <div>
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.body2">@InstallStageText</MudText>
                            @if (_installStage == UpdateStage.Downloading)
                            {
                                <MudText Typo="Typo.body2" Class="update-progress-percent">@((int)_installPercent)%</MudText>
                            }
                        </div>
                        @if (_installStage == UpdateStage.Downloading)
                        {
                            <MudProgressLinear Color="Color.Success" Rounded="true" Value="@_installPercent"/>
                        }
                        else
                        {
                            <MudProgressLinear Color="Color.Success" Rounded="true" Indeterminate="true"/>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-2 d-flex justify-end gap-2">
                        <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download" IconColor="Color.Success" OnClick="Install">@(LocaleHelper.Get("update_check_install"))</MudButton>
                        <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Default" OnClick="Close">@(LocaleHelper.Get("update_check_later"))</MudButton>
                    </div>
                }
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AvailableUpdate Update { get; set; } = default!;

    private readonly CancellationTokenSource _token = new();
    private bool _installing;
    private bool _restartRequired;
    private UpdateStage _installStage;
    private double _installPercent;

    private bool IsEdgeChannel => ConfigHelper.GetConfig().UpdateChannel == UpdateChannel.Edge;

    private string ChannelName => IsEdgeChannel ? LocaleHelper.Get("update_channel_edge") : LocaleHelper.Get("update_channel_stable");

    private string ChannelTooltip => $"{LocaleHelper.Get("update_check_channel_label")} {ChannelName}";

    private RenderFragment ChannelBadge =>
        @<MudTooltip Color="Color.Dark" Arrow="false" Placement="Placement.Top" Text="@ChannelTooltip">
            <div class="update-channel @(IsEdgeChannel ? "update-channel--edge" : "update-channel--stable")">
                <span class="update-channel-dot"></span>@ChannelName
            </div>
        </MudTooltip>;

    private string InstallStageText =>
        _installStage switch
        {
            UpdateStage.Downloading => LocaleHelper.Get("update_install_downloading"),
            UpdateStage.Restarting => LocaleHelper.Get("update_install_restarting"),
            _ => LocaleHelper.Get("update_install_applying"),
        };

    private async Task Install()
    {
        if (_installing)
        {
            return;
        }

        _installing = true;
        await SetDismissable(false);
        StateHasChanged();

        var progress = new Progress<UpdateProgress>(update =>
        {
            _installStage = update.Stage;
            _installPercent = update.Percent;
            _ = InvokeAsync(StateHasChanged);
        });

        UpdateFailure failure;
        try
        {
            failure = await UpdateInstaller.InstallAsync(Update, progress, _token.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError("Update install failed: {Exception}", ex);
            failure = UpdateFailure.Apply;
        }

        // On success the launcher is relaunching; the dialog exits with the process.
        if (failure == UpdateFailure.None)
        {
            return;
        }

        _installing = false;
        await SetDismissable(true);

        // A relaunch failure leaves the update committed and waiting on a manual restart.
        if (failure == UpdateFailure.Relaunch)
        {
            _restartRequired = true;
        }
        else
        {
            Snackbar.Add(FailureMessage(failure), Severity.Error);
        }

        StateHasChanged();
    }

    // Toggles backdrop-click and escape-key dismissal, carrying the shared dialog options over unchanged.
    private async Task SetDismissable(bool dismissable)
    {
        var shared = ConfigHelper.DialogOptions;
        await MudDialog.SetOptionsAsync(
            new DialogOptions
            {
                Position = shared.Position,
                MaxWidth = shared.MaxWidth,
                NoHeader = shared.NoHeader,
                FullWidth = shared.FullWidth,
                BackgroundClass = shared.BackgroundClass,
                BackdropClick = dismissable,
                CloseOnEscapeKey = dismissable,
            }
        );
    }

    private string FailureMessage(UpdateFailure failure) =>
        failure switch
        {
            UpdateFailure.InsufficientSpace => LocaleHelper.Get("update_install_no_space"),
            UpdateFailure.NotWritable => LocaleHelper.Get("update_install_not_writable"),
            UpdateFailure.Download => LocaleHelper.Get("update_install_download_failed"),
            _ => LocaleHelper.Get("update_install_failed"),
        };

    private void OpenNotes()
    {
        if (Update.Release.NotesUrl is { } url)
        {
            BrowserBridge.OpenExternal(url);
        }
    }

    private void Close()
    {
        _token.Cancel();
        MudDialog.Cancel();
    }
}
