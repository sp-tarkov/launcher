@inject ISnackbar Snackbar
@inject LocaleHelper LocaleHelper

<MudDialog Class="mud-background-gray border-2 border-solid mud-border-lines-default">
    <DialogContent>
        <MudContainer Class="py-4">
            <MudForm Model="_server" @bind-IsValid="@_success" Class="gap-2 mt-3">
                <MudTextField Immediate="true" @bind-Value="_server.Name" Label="@(LocaleHelper.Get("server_add_name"))" Required="true" RequiredError="@(LocaleHelper.Get("server_edit_required_name"))" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <MudTextField Immediate="true" @bind-Value="_server.IpAddress" Label="@(LocaleHelper.Get("server_add_address"))" Required="true" RequiredError="@(LocaleHelper.Get("server_add_required"))" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="IPAddress:6969 or sub.domain:6969" HelperTextOnFocus="true"/>
            </MudForm>
            <MudContainer Class="mt-3 d-flex justify-end pa-0 gap-2">
                <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy ml-auto" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success)" OnClick="Submit">@(LocaleHelper.Get("server_add_confirm"))</MudButton>
                <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy" Variant="Variant.Filled" Color="Color.Default" OnClick="Cancel">@(LocaleHelper.Get("server_add_cancel"))</MudButton>
            </MudContainer>
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    private bool _success;
    private Server _server = new();

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Submit()
    {
        _server.ServerId = DateTimeOffset.UtcNow.ToUnixTimeSeconds().ToString();
        _server.Locked = false;

        _server.IpAddress = _server.IpAddress.Replace("https://", "");
        _server.IpAddress = _server.IpAddress.Trim();

        Snackbar.Add(LocaleHelper.Get("server_add_success"), Severity.Success);
        MudDialog.Close(DialogResult.Ok(_server));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}
